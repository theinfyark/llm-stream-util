{
  "name": "llm-stream-util",
  "version": "1.1.0",
  "description": "Tiny helpers to stream LLM responses from OpenAI, Anthropic, and OpenAI-compatible APIs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test tests/stream.test.js",
    "prepublishOnly": "npm test && npm run build",
    "build": "tsup src/index.js --format cjs --clean --sourcemap"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "streaming",
    "sse",
    "ai",
    "chatgpt",
    "claude",
    "fetch",
    "server-sent-events",
    "stream",
    "gpt",
    "text-streaming",
    "openai-streaming",
    "token-stream",
    "nodejs"
  ],
  "author": "anilachary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theinfyark/llm-stream-util.git"
  },
  "bugs": {
    "url": "https://github.com/theinfyark/llm-stream-util/issues"
  },
  "homepage": "https://github.com/theinfyark/llm-stream-util#readme",
  "engines": {
    "node": ">=18"
  },
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/anilachary"
  },
  "module": "./src/index.js",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
